<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Community</title>
    <link rel="stylesheet" href="/css/style.css" />

  </head>
  <body>
    <%- include('../partials/_navbar.ejs') %>

    <h1>Community</h1>
    <ul>
      <% users.forEach(u => { %>
        <li>
          <a href="/users/<%= u._id %>"><%= u.username %></a>
        </li>
      <% }) %>
    </ul>
  </body>
</html>