<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= profileUser.username %>'s Pantry</title>
  </head>
  <body>
    <%- include('../partials/_navbar.ejs') %>

    <h1><%= profileUser.username %>'s Pantry</h1>
    <% if (profileUser.pantry.length === 0) { %>
      <p>This pantry is empty.</p>
    <% } else { %>
      <ul>
        <% profileUser.pantry.forEach(food => { %>
          <li><%= food.name %></li>
        <% }) %>
      </ul>
    <% } %>
  </body>
</html>