<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Pantry</title>
  </head>
  <body>
    <%- include('../partials/_navbar.ejs') %>

    <h1>Pantry</h1>
    <a href="/users/<%= userId %>/foods/new">Add New Item</a>

    <% if (foods.length === 0) { %>
      <p>There are no items in this pantry.</p>
    <% } else { %>
      <ul>
        <% foods.forEach(food => { %>
          <li>
            <%= food.name %>
            <% if (user && user._id === userId) { %>
              <a href="/users/<%= userId %>/foods/<%= food._id %>/edit">Edit</a>
              <form action="/users/<%= userId %>/foods/<%= food._id %>?_method=DELETE" method="POST" style="display:inline;">
                <button type="submit">Delete</button>
              </form>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </body>
</html>